# ==============================================================================
# Supabase Configuration
# ==============================================================================
# URL publique de votre projet Supabase (accessible côté client & serveur)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co

# Clé API anonyme (publique - protégée par Row Level Security RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_public_token

# Clé Service Role (PRIVÉE - Accès complet outrepassant RLS)
# ATTENTION: Utiliser UNIQUEMENT dans les scripts d'ingestion serveur, Route Handlers sécurisés ou Edge Functions.
# Ne JAMAIS préfixer par NEXT_PUBLIC_ ni exposer au client !
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_secret_token

# ==============================================================================
# Application Configuration
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Web Push (VAPID Keys pour notifications push navigateur)
# ==============================================================================
# Générées via : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BKxp9rJ8Q_example_public_vapid_key_abcdef123456
VAPID_PRIVATE_KEY=example_private_vapid_key_secret789
VAPID_SUBJECT=mailto:contact@workoffers.dev

# ==============================================================================
# APIs d'offres externes (Optionnel - Pour connecteurs MVP)
# ==============================================================================
# France Travail (ex-Pôle Emploi) API Emploi Store
FRANCE_TRAVAIL_CLIENT_ID=votre_client_id_francetravail
FRANCE_TRAVAIL_CLIENT_SECRET=votre_client_secret_francetravail
